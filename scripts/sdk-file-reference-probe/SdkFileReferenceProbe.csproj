<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
  </PropertyGroup>
  <ItemGroup>
    <Reference Include="YukkuriMovieMaker.Plugin">
      <HintPath>$(YmmSdkDir)/YukkuriMovieMaker.Plugin.dll</HintPath>
      <Private>true</Private>
      <ExternallyResolved>true</ExternallyResolved>
    </Reference>
  </ItemGroup>
  <Target Name="RequireYmmSdk" BeforeTargets="ResolveReferences">
    <Error Condition="'$(YmmSdkDir)' == '' Or !Exists('$(YmmSdkDir)/YukkuriMovieMaker.Plugin.dll')"
           Text="Set YmmSdkDir to a directory containing the official YukkuriMovieMaker.Plugin.dll." />
  </Target>
</Project>
