<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AssemblyName>YmmpxLibV2</AssemblyName>
    <RootNamespace>YmmpxLibV2</RootNamespace>
    <PackageId>YmmpxLibV2</PackageId>
    <Authors>hazimeyou</Authors>
    <Description>v2 core library for YmmpxLib.</Description>
    <RepositoryUrl>https://github.com/hazimeyou/YmmpxLib</RepositoryUrl>
    <PackageProjectUrl>https://github.com/hazimeyou/YmmpxLib</PackageProjectUrl>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <Deterministic>true</Deterministic>
    <ContinuousIntegrationBuild Condition="'$(GITHUB_ACTIONS)' == 'true'">true</ContinuousIntegrationBuild>
    <Version Condition="'$(Version)'==''">2.0.0-dev</Version>
  </PropertyGroup>
</Project>
